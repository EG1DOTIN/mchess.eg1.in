{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "docs/**",
      "unused-old-files/**",
      "automation-scripts/**",
      "Firestore/*.py",
      "Firestore/*.json"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/news.html",
        "destination": "/updates.html",
        "type": 301
      },
      {
        "source": "/news",
        "destination": "/updates",
        "type": 301
      },
      {
        "source": "/mi2/:path*",
        "destination": "/img/mi2/:path*",
        "type": 301
      },
      {
        "source": "/mi3/:path*",
        "destination": "/img/mi3/:path*",
        "type": 301
      },
      {
        "source": "/mi4/:path*",
        "destination": "/img/mi4/:path*",
        "type": 301
      },
      {
        "source": "/cpcq/:path*",
        "destination": "/img/cpcq/:path*",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|pgn|woff|woff2|ttf|eot)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000, public"
          }
        ]
      },
      {
        "source": "**/*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "Firestore/firestore.rules"
  }
}

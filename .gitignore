# ───── ignored files and folders ─────
gitignore

# ─── Internal Utility or local experiment/testing files ──────────────────
blog/test1.htm
blog/test.htm
blog/html_blog_fix.py
img/mchess-wall.png
img/mchess-web.webp

# ─── Firebase CLI Artifacts ──────────────────────────────
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# ─── Environment & Secrets ───────────────────────────────
.env
.env.*
*.env
*.pem
*serviceAccount*.json
*service_account*.json
firebase_credentials*.json

# ─── IDE & Editor Configurations ─────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── OS Specific Files ───────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Node & Python Cache ─────────────────────────────────
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/

# ─── AI AGENTS ─────────────────────────
.agents/
